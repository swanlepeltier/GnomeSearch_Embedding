# =============================================================================
# GnomeSearch Embedding — Configuration
# =============================================================================
# Copy this file to .env and adjust values to match your system.
#
#   cp .env.example .env
#
# All paths support ~ and $HOME expansion.
# =============================================================================

# ─── GPU Configuration ───────────────────────────────────────────────────────
# Which CUDA device index to use for the embedding model.
# Run `nvidia-smi` to see your GPUs. Set to the one you want to dedicate.
# Use -1 to force CPU-only mode.
CUDA_DEVICE_INDEX=1

# Torch dtype for model inference.
# Options: float32 (safest), bfloat16 (faster on Ampere+ GPUs)
# WARNING: Do NOT use float16 — it produces NaN values with this model.
TORCH_DTYPE=float32

# ─── Model Configuration ─────────────────────────────────────────────────────
# HuggingFace model ID
MODEL_ID=google/embeddinggemma-2

# Embedding dimension (Matryoshka truncation).
# Options: 768 (full), 512, 256 (recommended), 128
# Lower = smaller index + faster search, with minimal quality loss at 256.
EMBEDDING_DIM=256

# Which modalities to index. Queries are always text.
# Options: text_only | text_vision | text_audio | multimodal
# Fewer modalities = smaller index and faster indexing.
MODALITY=multimodal

# Batch size for encoding. Lower if you run out of VRAM.
BATCH_SIZE=16

# ─── Indexing Configuration ──────────────────────────────────────────────────
# Comma-separated list of directories to index.
# Supports ~ and $HOME. Subdirectories are included recursively.
WATCH_DIRS=~/Documents,~/Videos,~/Pictures,~/Music

# Where to store the FAISS index, SQLite database, and thumbnail cache.
# Defaults to ./data/ relative to the project root if not set.
DATA_DIR=./data

# ─── Video Processing ────────────────────────────────────────────────────────
# Extract one frame every N seconds from videos for indexing.
# Lower = more frames = better temporal precision, but larger index.
VIDEO_FRAME_INTERVAL=3

# Width (px) of generated thumbnails; video frames keep a 16:9 box.
THUMBNAIL_WIDTH=320

# Maximum number of characters read from a text file before embedding.
TEXT_MAX_CHARS=8000

# Supported file extensions (comma-separated, with dots)
VIDEO_EXTENSIONS=.mp4,.mkv,.avi,.webm,.mov,.flv,.wmv
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.bmp,.gif,.tiff,.svg
AUDIO_EXTENSIONS=.mp3,.flac,.wav,.ogg,.m4a,.aac,.wma
TEXT_EXTENSIONS=.txt,.md,.pdf,.docx,.odt,.py,.js,.ts,.rs,.c,.cpp,.h,.hpp,.java,.go,.json,.yaml,.yml,.toml,.csv,.xml,.html

# ─── D-Bus ────────────────────────────────────────────────────────────────────
# D-Bus service name and object path. Change only if you have conflicts.
DBUS_BUS_NAME=org.gnome.EmbeddingSearch
DBUS_OBJECT_PATH=/org/gnome/EmbeddingSearch

# ─── Search Behavior ─────────────────────────────────────────────────────────
# Maximum number of results returned per search query.
MAX_RESULTS=8

# Minimum similarity score (0.0 to 1.0) to include a result.
MIN_SCORE=0.15

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

